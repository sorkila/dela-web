# dela-web server config.
# Inleed serves via nginx in front of Apache; this file applies on the Apache layer.
# If a directive doesn't take effect, the same setting needs toggling in Inleed's
# control panel (Force HTTPS, custom 404, security headers).

# --- Force HTTPS ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  # Tell browsers to remember to use HTTPS for the next year.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Prevent MIME-type sniffing.
  Header set X-Content-Type-Options "nosniff"
  # Send only the origin on cross-site nav, full referrer same-origin.
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Dev notes stay private ---
# The deploy never uploads *.md, but an old CLAUDE.md from before that exclusion is still on
# the server (the FTP action doesn't delete excluded files). Answer 404 for any .md.
<IfModule mod_rewrite.c>
  RewriteRule \.md$ - [R=404,L]
</IfModule>
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>

# --- Branded 404 ---
ErrorDocument 404 /404.html

# --- Cache static assets aggressively ---
# Fonts and images are content-hashed by filename in practice (woff2 subsets,
# fixed PNGs); a 1y cache with immutable lets browsers and CDNs skip
# revalidation entirely. HTML and CSS are deliberately omitted so copy /
# style edits propagate immediately on deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
